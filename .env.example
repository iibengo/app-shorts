# AI Shorts — Composer real (Fal.ai)
# Copia este archivo a .env y rellena los secretos en local.
# No incluyas valores reales en el repositorio.

# Obligatoria. Clave privada de Fal.ai con permisos de Queue, Storage y modelos.
# Solo se usa en servidor (`runtimeConfig.falKey`); nunca se expone al cliente.
NUXT_FAL_KEY=

# Obligatoria. Secreto HMAC de al menos 32 caracteres para firmar los tokens de job.
NUXT_COMPOSER_JOB_SECRET=

# Rate limit y presupuesto (valores por defecto entre paréntesis).
NUXT_COMPOSER_GENERATE_LIMIT=3
NUXT_COMPOSER_GENERATE_WINDOW_MS=600000
NUXT_COMPOSER_UPLOAD_LIMIT=5
NUXT_COMPOSER_UPLOAD_WINDOW_MS=600000
NUXT_COMPOSER_MAX_ACTIVE_JOBS=1
NUXT_COMPOSER_MAX_GLOBAL_JOBS=3
NUXT_COMPOSER_DAILY_GENERATION_BUDGET=50

# Ciclo de vida de jobs y keyframe.
NUXT_COMPOSER_JOB_TTL_MS=3600000
NUXT_COMPOSER_KEYFRAME_TIMEOUT_MS=45000
NUXT_COMPOSER_POLL_AFTER_MS=2000

# Solo para tests con stubs locales. En producción se usan los defaults.
NUXT_COMPOSER_FAL_QUEUE_BASE_URL=https://queue.fal.run
NUXT_COMPOSER_FAL_RUN_BASE_URL=https://fal.run
NUXT_COMPOSER_FAL_STORAGE_BASE_URL=https://rest.fal.ai

# --- PostgreSQL (Spec 005) ---
# Local con docker-compose.yml (`docker compose up -d postgres`).
DATABASE_URL="postgresql://ai_shorts:ai_shorts@localhost:5432/ai_shorts?schema=public"
DIRECT_URL="postgresql://ai_shorts:ai_shorts@localhost:5432/ai_shorts?schema=public"

# Supabase: usa la conexión pooled (6543) para DATABASE_URL, con `?pgbouncer=true`,
# y la conexión directa (5432) para DIRECT_URL (migraciones e introspección).
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=public"
# DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?schema=public"

# --- Story (Spec 005) ---
# Obligatoria para el planificador de micro-relatos. Solo servidor.
NUXT_DEEPSEEK_KEY=
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# --- Director de dos pasadas (Spec 007) ---
# Desglose estimado del director: narrativa + visual + una reparación.
NUXT_STORY_COST_NARRATIVE_USD=0.01
NUXT_STORY_COST_VISUAL_USD=0.012
NUXT_STORY_COST_DIRECTOR_REPAIR_USD=0.01
# Timeouts por pasada y total compartido por AbortSignal.
NUXT_STORY_CANON_TIMEOUT_MS=60000
NUXT_STORY_BEATS_TIMEOUT_MS=60000
NUXT_STORY_VISUAL_TIMEOUT_MS=40000
NUXT_STORY_DIRECTOR_TOTAL_TIMEOUT_MS=180000
# Concurrencia del worker por shot y timeout de montaje 008.
NUXT_STORY_KEYFRAME_CONCURRENCY=6
NUXT_STORY_VIDEO_CONCURRENCY=4
NUXT_STORY_ASSEMBLY_TIMEOUT_MS=420000

# --- QC de continuidad (Spec 006) ---
# Interruptor del QC con visión. Si false, el QC solo hace la parte técnica.
NUXT_STORY_QC_ENABLED=false
# Coste estimado por evaluación de visión y escena.
NUXT_STORY_COST_QC_USD=0.02
# Spec 012: una imagen de referencia por personaje (Nano Banana / FLUX).
NUXT_STORY_COST_CHARACTER_REF_USD=0.04
# Consistency check (DeepSeek Vision) per keyframe. Off: it costs money per shot.
NUXT_STORY_CONSISTENCY_ENABLED=false
# Presupuesto total, lease, concurrencia y umbral de confianza.
NUXT_STORY_QC_TIMEOUT_MS=600000
NUXT_STORY_QC_LEASE_MS=720000
NUXT_STORY_QC_CONCURRENCY=1
NUXT_STORY_QC_MIN_CONFIDENCE=0.7
# Límite de qc/retry por historia.
NUXT_STORY_QC_RETRY_LIMIT=3
NUXT_STORY_QC_RETRY_WINDOW_MS=3600000
