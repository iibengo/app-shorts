{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "ionias": {
      "description": "Central orchestrator managing the SDD workflow, checkpoints and cross-agent context",
      "mode": "primary",
      "model": "anthropic/claude-opus-5-5"
    },
    "architect": {
      "description": "Generates formal specs under specs/ using the project constitution and prior patterns",
      "mode": "subagent"
    },
    "developer": {
      "description": "Implements approved Nuxt 4/Node features with SOLID server services and strict typing",
      "mode": "subagent"
    },
    "tester": {
      "description": "Validates specs with unit, route, component and acceptance tests",
      "mode": "subagent"
    },
    "reviewer": {
      "description": "Read-only reviewer for spec compliance, security, regressions and missing tests",
      "mode": "subagent"
    }
  }
}
